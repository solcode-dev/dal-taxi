# Database Configuration
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# CORS Configuration
# 로컬 개발 환경과 Replit 환경 모두를 위한 도메인 설정
# 콤마(,)로 구분하여 여러 도메인을 추가할 수 있습니다.
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5001,https://replit.com,https://replit.dev

# Replit 배포 시: Replit의 Secrets 메뉴에 ALLOWED_ORIGINS 키를 추가하고, 배포된 사이트 주소(예: https://your-app.replit.app)를 값으로 넣어주시면 됩니다. Replit 환경 변수가 .env 파일보다 우선순위가 높거나(설정에 따라 다름), .env 파일이 배포에 포함되지 않더라도 Secrets 값을 사용하게 됩니다.

# Client Configuration
EXPO_PUBLIC_API_URL=http://localhost:5001
